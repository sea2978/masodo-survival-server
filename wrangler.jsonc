{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "masodo-survival-server",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": "./server-public",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "OPERATING_HOURS_ENABLED": "true",
    "QUOTA_GUARD_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
